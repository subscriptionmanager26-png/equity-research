# Cursor automation trigger (the webhook that starts your agent)
CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
CURSOR_WEBHOOK_TOKEN=crsr_your_token

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Slack (pick one path) ---
#
# Quick start: user token polling (no Slack app required)
# Create at https://api.slack.com/apps → Your App → OAuth & Permissions → User Token Scopes
# Scopes: channels:history, channels:read, groups:history, groups:read, chat:write, files:write, users:read
SLACK_USER_TOKEN=xoxp-
# Word that means "call Relay" (case-insensitive). Default: pocketedge
SLACK_TRIGGER_WORD=pocketedge
# Optional: only watch these channels (comma-separated IDs). Empty = all joined channels.
# SLACK_CHANNEL_IDS=C01234567,C76543210
#
# Production path: Slack app + Socket Mode (bot posts as an app, not as you)
# SLACK_BOT_TOKEN=xoxb-
# SLACK_APP_TOKEN=xapp-
# SLACK_SIGNING_SECRET=

REPLY_WEBHOOK_SECRET=generate-a-long-random-string
PUBLIC_URL=
# On Vercel, PUBLIC_URL is inferred from VERCEL_URL — leave unset there.
# Local dev: use ./scripts/start-tunnel.sh or your own HTTPS host.

# Vercel Blob (auto-set when you attach Blob storage to the Vercel project)
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Protects /api/cursor/poll cron and POST /api/setup on Vercel
CRON_SECRET=

# Cursor status webhook (fast delivery when agent finishes)
# 1. Set PUBLIC_URL to your public Relay origin (https://…)
# 2. In Cursor → Cloud Agents → Webhooks, add: {PUBLIC_URL}/api/cursor/status
# 3. Paste the signing secret here
CURSOR_STATUS_WEBHOOK_SECRET=
