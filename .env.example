# Cursor automation trigger (the webhook that starts your agent)
CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
CURSOR_WEBHOOK_TOKEN=crsr_your_token

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional. If empty, Relay stores the chat id from the first /start message.
TELEGRAM_CHAT_ID=
# Optional. Required if you register a Telegram HTTPS webhook instead of polling.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret the agent uses when POSTing back to /api/reply
REPLY_WEBHOOK_SECRET=generate-a-long-random-string

# Public HTTPS origin of this app so the cloud agent can reach /api/reply
# Example: https://relay.example.com
PUBLIC_URL=

# Optional. HMAC secret if you also attach Cursor cloud-agent statusChange webhooks.
CURSOR_STATUS_WEBHOOK_SECRET=
