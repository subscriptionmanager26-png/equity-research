# Cursor API key (Dashboard → API Keys). Used to launch cloud agents.
CURSOR_WEBHOOK_TOKEN=crsr_your_token
# Optional: only if you still want the old Automations webhook
# CURSOR_USE_AUTOMATION_WEBHOOK=true
# CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
# Optional: reuse one standing cloud agent via follow-up (does not create a new dashboard run)
# CURSOR_REUSE_AGENT=true
# CURSOR_AGENT_ID=bc-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# CURSOR_AGENT_REPOSITORY=https://github.com/subscriptionmanager26-png/equity-research
# CURSOR_AGENT_REF=main
# Override Cloud Agent model (omit to use Cursor account default, currently Grok 4.6 High Fast)
# IDs from GET https://api.cursor.com/v1/models — e.g. grok-4.6, composer-2.5, claude-opus-5, claude-sonnet-5
# CURSOR_AGENT_MODEL=claude-opus-5
# Optional params: effort=low|medium|high|xhigh  fast=true|false  thinking=true|false
# CURSOR_AGENT_MODEL_PARAMS=effort=high,fast=false

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Slack (pick one path) ---
#
# Quick start: user token polling (no Slack app required)
# Create at https://api.slack.com/apps → Your App → OAuth & Permissions → User Token Scopes
# Scopes: channels:history, channels:read, groups:history, groups:read, chat:write, reactions:write, files:write, users:read
SLACK_USER_TOKEN=xoxp-
# Word that means "call Relay" (case-insensitive). Default: pocketedge
SLACK_TRIGGER_WORD=pocketedge
# Optional Slack user id for @pocketedge mentions (<@U…>)
# SLACK_MENTION_USER_ID=U01234567
# Optional: only watch these channels (comma-separated IDs). Empty = all joined channels.
# SLACK_CHANNEL_IDS=C01234567,C76543210
#
# Bot token is only used to receive Events API webhooks on Vercel.
# Replies always use SLACK_USER_TOKEN (as you) when that is set.
# SLACK_BOT_TOKEN=xoxb-
# SLACK_SIGNING_SECRET=

REPLY_WEBHOOK_SECRET=generate-a-long-random-string
PUBLIC_URL=
# On Vercel, PUBLIC_URL is inferred from VERCEL_URL — leave unset there.
# Local dev: use ./scripts/start-tunnel.sh or your own HTTPS host.

# Job store on Vercel: Upstash Redis (REST). Blob Hobby is 10k ops/month and
# is too small for Relay. Create a free Redis DB at https://console.upstash.com
# then set both of these on Vercel Production:
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Optional: RELAY_STORE=blob|file to force the old backends.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (leave unset once Upstash is configured)
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Protects /api/cursor/poll cron and POST /api/setup on Vercel
CRON_SECRET=

# Reliable ~1/min Slack scan on Vercel Hobby (same Upstash console as Redis)
# https://console.upstash.com/qstash → create token → add to Vercel Production
# QSTASH_TOKEN=

# Cursor status webhook (fast delivery when agent finishes)
# 1. Set PUBLIC_URL to your public Relay origin (https://…)
# 2. In Cursor → Cloud Agents → Webhooks, add: {PUBLIC_URL}/api/cursor/status
# 3. Paste the signing secret here
CURSOR_STATUS_WEBHOOK_SECRET=
